[Unit]
Description=Hermes gateway and router with active progress supervision
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=%h/hermes-cloud-gateway
Environment="PATH=%h/.local/bin:%h/.hermes/bin:%h/.hermes/node/bin:/usr/local/bin:/usr/bin:/bin"
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Jakarta
ExecStart=/usr/bin/python3 %h/hermes-cloud-gateway/ops/supervise.py --max-runtime 0
Restart=always
RestartSec=5
TimeoutStartSec=420
TimeoutStopSec=80
WatchdogSec=60
WatchdogSignal=SIGKILL
KillMode=mixed
SendSIGKILL=yes
LimitNOFILE=65536
MemoryHigh=3G
MemoryMax=4G
TasksMax=512
OOMPolicy=kill
UMask=0077
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=default.target
