#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
export DO_NOT_TRACK=1
export CUA_TELEMETRY=0
SKILL_CUA="$HOME/.hermes/skills/antigravity-laptop/cua"
if [ ! -f "$HOME/.cua/credentials.json" ] && [ -d "$SKILL_CUA" ]; then
  mkdir -p "$HOME/.cua"
  chmod 700 "$HOME/.cua"
  cp -f "$SKILL_CUA/"* "$HOME/.cua/"
  chmod 600 "$HOME/.cua/"* 2>/dev/null || true
fi
if ! command -v cua >/dev/null 2>&1; then
  curl -fsSL https://cua.ai/install.sh | sh -s -- --cli-only --yes --no-onboarding >/dev/null 2>&1
fi
if [ $# -eq 0 ]; then
  echo "Usage: agy-laptop [--ide | --app | --cli] [--status | --ide-status | --read [id|last] | --last <prompt> | --conversation <id> <prompt> | --cd <dir> <prompt> | <prompt>]"
  exit 1
fi

SURFACE="CLI"
MODE="ASK"
CONV_ID=""
CD_DIR=""
READ_TARGET="last"
ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --ide)
      SURFACE="IDE"
      shift
      ;;
    --app)
      SURFACE="APP"
      shift
      ;;
    --cli)
      SURFACE="CLI"
      shift
      ;;
    --status|status)
      MODE="STATUS"
      shift
      ;;
    --ide-status)
      MODE="IDE_STATUS"
      shift
      ;;
    --read|read)
      MODE="READ"
      if [ $# -ge 2 ] && [[ ! "$2" =~ ^-- ]]; then
        READ_TARGET="$2"
        shift 2
      else
        shift
      fi
      ;;
    --last|-l|--continue)
      MODE="LAST"
      shift
      ;;
    --conversation|-c|-r)
      MODE="CONV"
      CONV_ID="$2"
      shift 2
      ;;
    --cd|-C)
      CD_DIR="$2"
      shift 2
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

PROMPT_STR="${ARGS[*]:-}"

if [ "$MODE" = "STATUS" ]; then
  if [ "$SURFACE" = "IDE" ]; then
    PAYLOAD="__IDE_STATUS__"
  else
    PAYLOAD="__STATUS__"
  fi
elif [ "$MODE" = "IDE_STATUS" ]; then
  PAYLOAD="__IDE_STATUS__"
elif [ "$MODE" = "READ" ]; then
  if [ "$SURFACE" = "IDE" ]; then
    PAYLOAD="__READ__:ide:${READ_TARGET}"
  elif [ "$SURFACE" = "APP" ]; then
    PAYLOAD="__READ__:app:${READ_TARGET}"
  else
    PAYLOAD="__READ__:auto:${READ_TARGET}"
  fi
elif [ "$SURFACE" = "IDE" ]; then
  if [ "$MODE" = "CONV" ]; then
    PAYLOAD="__IDE_CONV__:${CONV_ID}:${PROMPT_STR}"
  elif [ "$MODE" = "LAST" ]; then
    PAYLOAD="__IDE_LAST__:${PROMPT_STR}"
  elif [ -n "$CD_DIR" ]; then
    PAYLOAD="__IDE_CD__:${CD_DIR}:${PROMPT_STR}"
  else
    PAYLOAD="__IDE__:${PROMPT_STR}"
  fi
elif [ "$SURFACE" = "APP" ]; then
  if [ "$MODE" = "CONV" ]; then
    PAYLOAD="__APP_CONV__:${CONV_ID}:${PROMPT_STR}"
  elif [ "$MODE" = "LAST" ]; then
    PAYLOAD="__APP_LAST__:${PROMPT_STR}"
  else
    PAYLOAD="__APP__:${PROMPT_STR}"
  fi
else
  if [ "$MODE" = "CONV" ]; then
    PAYLOAD="__CONV__:${CONV_ID}:${PROMPT_STR}"
  else
    PAYLOAD="${PROMPT_STR}"
  fi
fi

PROMPT_B64=$(printf '%s' "$PAYLOAD" | base64 -w0)
if [ -f "/mnt/c/Users/ardhy/.gemini/antigravity/run-agy.ps1" ]; then
  /usr/local/bin/powershell.exe -NoProfile -ExecutionPolicy Bypass -File 'C:\Users\ardhy\.gemini\antigravity\run-agy.ps1' "$PROMPT_B64"
else
  CUA_MESH=off cua sandbox exec -i relay:93329d6adee2e404fe3b7f11a51ce178 -- \
    /usr/local/bin/powershell.exe -NoProfile -ExecutionPolicy Bypass -File 'C:\Users\ardhy\.gemini\antigravity\run-agy.ps1' "$PROMPT_B64"
fi
