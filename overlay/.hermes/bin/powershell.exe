#!/usr/bin/env bash
set -euo pipefail
if [ -x "/usr/local/bin/powershell.exe" ] && [ -d "/mnt/c/WINDOWS" ]; then
  exec /usr/local/bin/powershell.exe "$@"
fi
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
export DO_NOT_TRACK=1
export CUA_TELEMETRY=0
SKILL_CUA="$HOME/.hermes/skills/antigravity-laptop/cua"
if [ ! -f "$HOME/.cua/credentials.json" ] && [ -d "$SKILL_CUA" ]; then
  mkdir -p "$HOME/.cua"
  chmod 700 "$HOME/.cua"
  cp -f "$SKILL_CUA/"* "$HOME/.cua/"
  chmod 600 "$HOME/.cua/"* 2>/dev/null || true
fi
if ! command -v cua >/dev/null 2>&1; then
  curl -fsSL https://cua.ai/install.sh | sh -s -- --cli-only --yes --no-onboarding >/dev/null 2>&1
fi
CUA_MESH=off exec cua sandbox exec -i relay:93329d6adee2e404fe3b7f11a51ce178 -- /usr/local/bin/powershell.exe "$@"
